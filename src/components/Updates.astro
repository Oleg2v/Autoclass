---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { copy, he } from '../data/copy.js';
import { waLink } from '../data/site.js';
import before from '../assets/photos/before-door-dent.jpg';
import booth from '../assets/photos/paint-booth.jpg';
import after from '../assets/photos/after-repair.jpg';

const c = copy.updates;
const photos = { before, booth, after } as const;
const alts = { before: copy.work.alts[0], booth: copy.work.alts[1], after: copy.work.alts[2] } as const;
---
<section class="chat" id="updates" data-chat data-cid="updates" aria-labelledby="chat-title">
  <div class="chat__stick">
    <div class="chat__in wrap">
      <div class="chat__text">
        <p class="eyebrow">{he(c.eyebrow)}</p>
        <h2 class="display h2" id="chat-title">{he(c.h2)}</h2>
        <p class="lead">{he(c.lead)}</p>
        <a class="btn chat__cta" href={waLink()} target="_blank" rel="noopener" data-cursor-label={he(copy.headerWa)}>
          <Icon name="whatsapp" />{he(copy.hero.cta)}<span class="sr-only">{he(copy.a11y.waNewTab)}</span>
        </a>
        <p class="chat__note">{he(c.note)}</p>
      </div>

      <figure class="phone" aria-label={he(c.chatLabel)}>
        <div class="phone__screen">
          <div class="phone__bar">
            <span class="phone__avatar" aria-hidden="true"><Logo class="phone__logo" decorative /></span>
            <span class="phone__who">
              <b>{he(c.name)}</b>
              <span class="phone__status" data-chat-status>
                <span class="phone__sub">{he(c.sub)}</span>
                <span class="phone__typing-text">{he(c.typing)}</span>
              </span>
            </span>
          </div>
          <ol class="phone__msgs">
            {c.messages.map((m) => (
              <li class:list={['msg', `msg--${m.from}`, { 'msg--status': m.status }]} data-msg data-from={m.from}>
                {m.day && <span class="msg__day">{he(m.day)}</span>}
                <div class="msg__bubble">
                  <span class="sr-only">{m.from === 'me' ? he(c.you) : he(c.name)}:</span>
                  {m.photo && (
                    <div class="msg__photo">
                      <Picture
                        src={photos[m.photo as keyof typeof photos]}
                        alt={he(alts[m.photo as keyof typeof alts])}
                        formats={['avif', 'webp']}
                        widths={[240, 480]}
                        sizes="240px"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}
                  <span class="msg__text">{m.he}</span>
                  <span class="msg__meta" aria-hidden="true">{m.time}{m.from === 'me' && <span class="msg__ticks">✓✓</span>}</span>
                </div>
              </li>
            ))}
            <li class="msg msg--shop msg--typing" data-typing aria-hidden="true">
              <div class="msg__bubble"><i></i><i></i><i></i></div>
            </li>
          </ol>
          <div class="phone__input" aria-hidden="true"><span></span><i><Icon name="whatsapp" /></i></div>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .chat { position: relative; background: var(--ink); }
  .chat__stick { padding-block: clamp(5rem, 10vw, 8rem); }
  .chat__in {
    display: grid;
    grid-template-columns: 1fr minmax(300px, 380px);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .chat__cta { margin-block-start: 2rem; }
  .chat__note {
    margin-block-start: 1.25rem;
    font-size: .875rem;
    color: var(--muted-on-dark);
    display: flex;
    gap: .5rem;
    align-items: center;
  }
  .chat__note::before { content: 'i'; display: grid; place-items: center; inline-size: 20px; block-size: 20px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px currentColor; font-size: .75rem; font-weight: 700; flex: none; }

  .phone {
    position: relative;
    justify-self: center;
    inline-size: min(100%, 360px);
    aspect-ratio: 9 / 18.5;
    max-block-size: min(720px, 78svh);
    padding: 10px;
    border-radius: 46px;
    background: linear-gradient(145deg, #2a2d25, #0c0d0b);
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .1), 0 40px 80px -30px rgb(0 0 0 / .8), 0 0 0 1px #000;
  }
  .phone__screen {
    position: relative;
    display: flex;
    flex-direction: column;
    block-size: 100%;
    border-radius: 37px;
    overflow: hidden;
    background-color: #0b141a;
    background-image: radial-gradient(rgb(255 255 255 / .035) 1px, transparent 1px);
    background-size: 16px 16px;
    font-size: 14.5px;
    line-height: 1.4;
  }
  .phone__bar {
    display: flex; align-items: center; gap: .65rem;
    padding: 2.1rem .9rem .7rem;
    background: #1f2c34;
    color: #e9edef;
  }
  .phone__avatar { display: grid; place-items: center; inline-size: 38px; block-size: 38px; border-radius: 50%; background: var(--ink); flex: none; overflow: hidden; }
  .phone__avatar :global(.phone__logo) { inline-size: 32px; block-size: auto; color: var(--lime); }
  .phone__who { display: grid; line-height: 1.25; }
  .phone__who b { font-weight: 600; font-size: 15px; }
  .phone__status { position: relative; font-size: 12.5px; color: #8696a0; }
  .phone__typing-text { display: none; color: #25d366; }
  .phone__status.is-typing .phone__sub { display: none; }
  .phone__status.is-typing .phone__typing-text { display: inline; }

  .phone__msgs {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: .35rem;
    padding: .75rem .7rem;
    overflow: hidden;
  }
  .msg { display: flex; flex-direction: column; align-items: flex-start; }
  .msg--me { align-items: flex-end; }
  .msg__day {
    align-self: center;
    margin-block: .5rem .4rem;
    padding: .2rem .7rem;
    border-radius: 8px;
    background: #182229;
    color: #8696a0;
    font-size: 12px;
  }
  .msg__bubble {
    position: relative;
    max-inline-size: 84%;
    padding: .38rem .6rem .3rem;
    border-radius: 10px;
    background: #202c33;
    color: #e9edef;
    box-shadow: 0 1px .5px rgb(0 0 0 / .13);
  }
  .msg--me .msg__bubble { background: #005c4b; }
  .msg--shop .msg__bubble { border-start-start-radius: 2px; }
  .msg--me .msg__bubble { border-start-end-radius: 2px; }
  .msg--status .msg__text { font-weight: 600; }
  .msg__photo :global(img) { display: block; inline-size: 220px; max-inline-size: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 7px; margin-block-end: .3rem; }
  .msg__meta { display: inline-flex; gap: .2rem; float: inline-end; margin-inline-start: .6rem; margin-block-start: .35rem; font-size: 11px; color: rgb(233 237 239 / .6); direction: ltr; }
  .msg__ticks { color: #53bdeb; letter-spacing: -3px; }
  .msg--typing { display: none; }
  .msg--typing .msg__bubble { display: inline-flex; gap: 4px; padding: .7rem .8rem; }
  .msg--typing i { inline-size: 7px; block-size: 7px; border-radius: 50%; background: #8696a0; animation: blink 1.1s infinite; }
  .msg--typing i:nth-child(2) { animation-delay: .15s; }
  .msg--typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes blink { 0%, 60%, 100% { opacity: .35; transform: none; } 30% { opacity: 1; transform: translateY(-3px); } }
  .phone__input { display: flex; gap: .5rem; align-items: center; padding: .55rem .7rem 1.1rem; }
  .phone__input span { flex: 1; block-size: 40px; border-radius: 999px; background: #1f2c34; }
  .phone__input i { display: grid; place-items: center; inline-size: 40px; block-size: 40px; border-radius: 50%; background: #00a884; color: #fff; }
  .phone__input :global(svg) { inline-size: 20px; block-size: 20px; }

  /* ── Live (scroll-driven) ── */
  .chat:not(.is-live) .phone__msgs { overflow-y: auto; justify-content: flex-start; }
  .chat.is-live { block-size: 280vh; }
  .chat.is-live .chat__stick { position: sticky; inset-block-start: 0; block-size: 100svh; display: grid; align-items: center; padding-block: calc(var(--header-h) + 1rem) 1.5rem; }
  .chat.is-live .msg[data-msg] { display: none; }
  .chat.is-live .msg[data-msg].is-shown { display: flex; animation: pop .45s var(--ease-spring) both; }
  .chat.is-live .msg--typing.is-on { display: flex; animation: pop .3s var(--ease-out) both; }
  @keyframes pop { from { opacity: 0; transform: translateY(12px) scale(.96); } }

  @media (max-width: 900px) {
    .chat__in { grid-template-columns: 1fr; }
    .chat.is-live { block-size: 300vh; }
    .chat.is-live .chat__in { gap: 1rem; align-content: start; block-size: 100%; grid-template-rows: auto 1fr; }
    .chat.is-live .chat__text .lead, .chat.is-live .chat__cta { display: none; }
    .chat.is-live .chat__text .h2 { font-size: clamp(2.1rem, 9vw, 3rem); margin-block: .4rem 0; }
    .chat.is-live .chat__note { margin-block-start: .4rem; }
    .chat.is-live .phone { block-size: 100%; max-block-size: none; aspect-ratio: auto; inline-size: min(100%, 380px); min-block-size: 0; }
    .chat:not(.is-live) .phone { inline-size: min(100%, 340px); }
    .msg__photo :global(img) { inline-size: 170px; }
  }
</style>
