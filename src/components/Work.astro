---
import { Picture } from 'astro:assets';
import { copy, he } from '../data/copy.js';
import before from '../assets/photos/before-door-dent.jpg';
import booth from '../assets/photos/paint-booth.jpg';
import after from '../assets/photos/after-repair.jpg';

const c = copy.work;
const frames = [
  { src: before, origin: '30% 60%' },
  { src: booth, origin: '40% 55%' },
  { src: after, origin: '36% 74%' },
];
const valueText = JSON.stringify(c.valueText.map((t) => t.he));
---
<section class="work section" id="work" data-cid="work" aria-labelledby="work-title">
  <div class="wrap work__in">
    <div class="work__text">
      <p class="eyebrow" data-reveal>{he(c.eyebrow)}</p>
      <h2 class="display h2" id="work-title" data-reveal style="--d:1">{he(c.h2)}</h2>
      <p class="lead" data-reveal style="--d:2">{he(c.lead)}</p>
      <div class="work__steps" role="group" aria-label={he(c.sliderLabel)} data-reveal style="--d:3">
        {c.labels.map((l, i) => (
          <button type="button" class="work__go" data-ba-go={i * 50} aria-controls="ba-handle" aria-pressed={i === 0 ? 'true' : 'false'}>
            <span aria-hidden="true">0{i + 1}</span>{l.he}
          </button>
        ))}
      </div>
    </div>

    <figure class="ba" data-ba data-ba-text={valueText} data-cid="before-after" data-reveal style="--d:1">
      <div class="ba__frame" data-ba-track data-cursor-label={he(c.drag)}>
        {frames.map((f, i) => (
          <div class="ba__layer" data-ba-frame style={`transform-origin:${f.origin}`}>
            <Picture
              src={f.src}
              alt={he(c.alts[i])}
              formats={['avif', 'webp']}
              widths={[480, 700]}
              sizes="(max-width: 900px) 92vw, 640px"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
        <div class="ba__labels" aria-hidden="true">
          {c.labels.map((l, i) => <span style={`--k:${i}`}>{l.he}</span>)}
        </div>
        <div class="ba__track" aria-hidden="true"><i></i></div>
        <div
          class="ba__handle"
          id="ba-handle"
          data-ba-handle
          role="slider"
          tabindex="0"
          aria-label={he(c.sliderLabel)}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          aria-valuetext={c.valueText[0].he}
          aria-orientation="horizontal"
        >
          <span class="ba__knob" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </div>
      <figcaption class="ba__cap">{he(c.caption)}</figcaption>
    </figure>
  </div>
</section>

<style>
  .work { background: var(--ink); }
  .work__in { display: grid; grid-template-columns: 1fr minmax(320px, 640px); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .work__steps { display: flex; flex-wrap: wrap; gap: .5rem; margin-block-start: 2rem; }
  .work__go {
    display: inline-flex; align-items: center; gap: .5rem;
    min-block-size: 44px;
    padding: .5rem 1rem;
    border: 0; border-radius: 999px;
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--line-dark);
    font-weight: 600;
    cursor: pointer;
    transition: background-color .3s, color .3s, box-shadow .3s;
  }
  .work__go span { font-size: .75rem; color: var(--lime); }
  .work__go[aria-pressed='true'] { background: var(--lime); color: var(--ink); box-shadow: none; }
  .work__go[aria-pressed='true'] span { color: var(--ink); }

  .ba { position: relative; }
  .ba__frame {
    --v: 0;
    position: relative;
    aspect-ratio: 1;
    border-radius: calc(var(--radius) * 1.4);
    overflow: hidden;
    background: var(--ink-2);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }
  .ba.is-dragging .ba__frame { cursor: grabbing; }
  .ba__layer { position: absolute; inset: 0; will-change: transform, opacity; }
  .ba__layer + .ba__layer { opacity: 0; }
  .ba__layer :global(picture) { display: block; block-size: 100%; }
  .ba__layer :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; pointer-events: none; }
  .ba__frame::after { /* film grain + vignette for visual unity of old phone photos */
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(120% 90% at 50% 40%, transparent 55%, rgb(0 0 0 / .45));
    pointer-events: none;
  }
  .ba__labels { position: absolute; inset-block-start: 1rem; inset-inline: 1rem; display: flex; justify-content: space-between; z-index: 2; pointer-events: none; }
  .ba__labels span {
    padding: .3rem .7rem;
    border-radius: 999px;
    background: rgb(18 19 16 / .7);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    font-size: .8125rem;
    font-weight: 700;
    opacity: calc(1 - min(1, abs(var(--v) - var(--k) * 50) / 30));
  }
  .ba__track { position: absolute; inset-inline: 1.25rem; inset-block-end: 1.6rem; block-size: 3px; border-radius: 3px; background: rgb(238 237 230 / .25); z-index: 2; pointer-events: none; }
  .ba__track i { position: absolute; inset-block: 0; inset-inline-start: 0; inline-size: calc(var(--v) * 1%); background: var(--lime); border-radius: inherit; }
  .ba__handle {
    position: absolute;
    z-index: 3;
    inset-block-end: calc(1.6rem + 1.5px);
    inset-inline-start: calc(1.25rem + (100% - 2.5rem) * var(--v) / 100);
    inline-size: 0; block-size: 0;
    outline: none;
  }
  .ba__knob {
    position: absolute;
    inset-inline-start: -26px;
    inset-block-start: -26px;
    display: grid; place-items: center;
    inline-size: 52px; block-size: 52px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
    box-shadow: 0 10px 30px -8px rgb(0 0 0 / .6);
    transition: transform .3s var(--ease-out);
  }
  .ba__knob svg { inline-size: 24px; block-size: 24px; }
  .ba__handle:focus-visible .ba__knob { outline: 3px solid var(--paper); outline-offset: 3px; }
  .ba.is-dragging .ba__knob { transform: scale(1.12); }
  .ba__cap { margin-block-start: 1rem; font-size: .875rem; color: var(--muted-on-dark); }

  @media (max-width: 900px) {
    .work__in { grid-template-columns: 1fr; }
    .ba { order: 2; }
    .work__steps { margin-block-start: 1.25rem; }
  }
</style>
