---
import Car from './car/Car.astro';
import Icon from './Icon.astro';
import * as G from './car/geometry.js';
import { copy, he } from '../data/copy.js';

const s = copy.story;
const pct = (v: number, max: number) => `${((v / max) * 100).toFixed(2)}%`;
---
<section class="story" id="process" data-story data-cid="process" aria-labelledby="story-title">
  <div class="story__stick">
    <div class="story__bg" aria-hidden="true">
      <div class="story__bg-blue"></div>
      <div class="story__bg-booth"></div>
      <div class="story__bg-glow"></div>
    </div>

    <div class="story__in wrap">
      <header class="story__head">
        <p class="eyebrow">{he(s.eyebrow)}</p>
        <h2 class="display story__title" id="story-title">{he(s.h2)}</h2>
        <p class="story__intro">{he(s.intro)}</p>
      </header>

      <div class="story__text">
        <p class="story__count" aria-hidden="true">
          <span class="story__count-now" data-story-now>01</span>
          <span class="story__count-sep">/</span>
          <span>04</span>
        </p>
        <ol class="story__steps">
          {s.steps.map((st, i) => (
            <li class:list={['story__step', { 'is-active': i === 0 }]} data-step={i} data-cid={`step-${i + 1}`} data-verify={st.verify ? he(copy.verifyBadge) : undefined}>
              <span class="story__step-num" aria-hidden="true">0{i + 1}</span>
              <h3 class="story__step-title">{he(st.title)}</h3>
              <p class="story__step-text">{he(st.text)}</p>
            </li>
          ))}
        </ol>
        <div class="story__rail" aria-hidden="true">
          {s.steps.map((st, i) => (
            <span class="story__rail-seg" data-rail={i}><i></i><b>{he(st.title)}</b></span>
          ))}
        </div>
      </div>

      <div class="story__visual" data-glint>
        <div class="story__car">
          <Car prefix="s" variant="story" label={he(s.carLabel)} />

          <div class="story__scan" aria-hidden="true"><i></i></div>

          <ul class="story__spots" aria-hidden="true">
            {G.hotspots.map((h, i) => (
              <li class="story__spot" data-spot={i} style={`--x:${pct(h.x, G.VIEW.w)};--y:${pct(h.y, G.VIEW.h)}`}>
                <span class="story__spot-dot"></span>
                <span class="story__spot-label">{he(s.hotspots[i])}</span>
              </li>
            ))}
          </ul>

          <div class="story__claim" aria-hidden="true">
            <p class="story__claim-title">{he(s.claim.title)}</p>
            <ul>
              {s.claim.items.map((it) => (
                <li><span class="story__tick"><Icon name="check" /></span>{he(it)}</li>
              ))}
            </ul>
          </div>

          <span class="story__tag story__tag--paint" aria-hidden="true">{he(s.paint)}</span>
          <span class="story__tag story__tag--keys" aria-hidden="true">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12.5 12H21m-3 0v3m-3-3v2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            {he(s.keys)}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Static layout (no JS / reduced motion): a readable list with the restored car ── */
  .story { position: relative; background: var(--ink); }
  .story__stick { position: relative; overflow: clip; padding-block: clamp(5rem, 10vw, 8rem); }
  .story__in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(280px, 0.6fr) 2fr;
    grid-template-areas: 'head head' 'text visual';
    gap: clamp(1.5rem, 3vw, 3rem) clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }
  .story__head { grid-area: head; }
  .story__title { font-size: clamp(2.6rem, 1.4rem + 5vw, 6rem); margin-block: .6rem .6rem; }
  .story__intro { color: var(--muted-on-dark); font-size: 1.0625rem; }
  .story__text { grid-area: text; position: relative; }
  .story__visual { grid-area: visual; position: relative; margin-inline-end: calc(var(--pad) * -1 - 2vw); }
  .story__car { position: relative; color: var(--lime); }
  .story__car :global(.car) { inline-size: 100%; block-size: auto; overflow: visible; }

  .story__count { display: none; font-weight: 700; font-stretch: 75%; font-size: 1rem; color: var(--muted-on-dark); gap: .35rem; }
  .story__count-now { color: var(--lime); }
  .story__steps { display: grid; gap: 1.75rem; counter-reset: step; }
  .story__step-num { display: block; font-weight: 700; font-size: .875rem; color: var(--lime); margin-block-end: .35rem; }
  .story__step-title { font-weight: 800; font-stretch: 75%; font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem); line-height: 1.05; margin-block-end: .5rem; }
  .story__step-text { color: var(--muted-on-dark); max-inline-size: 36ch; }
  .story__rail { display: none; }

  .story__scan, .story__spots, .story__claim, .story__tag { display: none; }
  .story__bg { position: absolute; inset: 0; pointer-events: none; }
  .story__bg > div { position: absolute; inset: 0; opacity: 0; }

  /* In the static fallback the car is shown fully restored. */
  .story:not(.is-live) :global(.car__damage),
  .story:not(.is-live) :global(.car__cracks) { display: none; }
  .story:not(.is-live) :global([data-wave]) { transform: translate(-90px, 0); }

  /* ── Live scroll-driven version (enabled by JS) ── */
  .story.is-live { block-size: 520vh; }
  .story.is-live .story__stick {
    position: sticky;
    inset-block-start: 0;
    block-size: 100svh;
    padding-block: calc(var(--header-h) + 1rem) 2rem;
    display: grid;
    align-items: center;
  }
  .story.is-live .story__in { block-size: 100%; grid-template-rows: auto 1fr; align-content: stretch; }
  .story.is-live .story__head { align-self: start; }
  .story.is-live .story__count { display: flex; margin-block-end: 1rem; }
  .story.is-live .story__steps { display: grid; grid-template-areas: 'stack'; gap: 0; }
  .story.is-live .story__step {
    grid-area: stack;
    opacity: 0;
    transform: translateY(22px);
    transition: opacity .55s var(--ease-out), transform .8s var(--ease-out);
    pointer-events: none;
  }
  .story.is-live .story__step.is-active { opacity: 1; transform: none; pointer-events: auto; }
  .story.is-live .story__step-num { display: none; }
  .story.is-live .story__step-title { font-size: clamp(2rem, 1.2rem + 2.6vw, 3.6rem); font-weight: 860; font-stretch: 68%; }

  .story.is-live .story__rail { display: grid; gap: .9rem; margin-block-start: 2.5rem; }
  .story__rail-seg { display: grid; grid-template-columns: 56px 1fr; align-items: center; gap: .9rem; font-size: .875rem; color: var(--muted-on-dark); transition: color .4s; }
  .story__rail-seg i { position: relative; block-size: 2px; background: var(--line-dark); overflow: hidden; }
  .story__rail-seg i::after { content: ''; position: absolute; inset: 0; background: var(--lime); transform: scaleX(var(--p, 0)); transform-origin: right; }
  .story__rail-seg b { font-weight: 500; }
  .story__rail-seg.is-active { color: var(--text-on-dark); }

  .story.is-live .story__scan { display: block; position: absolute; inset-block: -6% 6%; inset-inline-start: 0; inline-size: 100%; pointer-events: none; }
  .story__scan i {
    position: absolute;
    inset-block: 0;
    left: var(--scan, 100%);
    inline-size: 2px;
    background: var(--lime);
    box-shadow: 0 0 18px 3px rgb(185 202 19 / .55);
    opacity: var(--scan-o, 0);
  }
  .story__scan i::after { /* trailing light */
    content: '';
    position: absolute;
    inset-block: 0;
    left: 2px;
    inline-size: 120px;
    background: linear-gradient(to right, rgb(185 202 19 / .18), transparent);
  }

  .story.is-live .story__spots { display: block; position: absolute; inset: 0; pointer-events: none; }
  .story__spot { position: absolute; left: var(--x); top: var(--y); opacity: 0; transform: scale(.4); }
  .story__spot-dot {
    position: absolute;
    inset-inline-start: 0;
    inline-size: 18px; block-size: 18px;
    margin: -9px -9px 0 0;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 6px rgb(255 91 56 / .22);
  }
  .story__spot-dot::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1.5px solid var(--signal);
    animation: ping 1.8s var(--ease-out) infinite;
  }
  @keyframes ping { from { transform: scale(.5); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }
  .story__spot-label {
    position: absolute;
    inset-block-end: 18px;
    inset-inline-start: -8px;
    padding: .25rem .6rem;
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    font-size: .8125rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .story__spot:nth-child(odd) .story__spot-label { inset-block-end: auto; inset-block-start: 18px; }

  .story.is-live .story__claim {
    display: block;
    position: absolute;
    inset-block-start: -4%;
    left: 2%;
    inline-size: min(300px, 46%);
    padding: 1.1rem 1.2rem 1.2rem;
    border-radius: var(--radius);
    background: rgb(238 237 230 / .96);
    color: var(--ink);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / .6);
    opacity: 0;
    transform: translateY(20px) rotate(-2deg);
  }
  .story__claim-title { font-weight: 800; font-stretch: 80%; font-size: 1.25rem; margin-block-end: .7rem; padding-block-end: .6rem; border-block-end: 1px dashed rgb(18 19 16 / .25); }
  .story__claim li { display: flex; align-items: center; gap: .6rem; padding-block: .3rem; font-weight: 500; font-size: .9375rem; }
  .story__tick {
    display: grid; place-items: center;
    inline-size: 22px; block-size: 22px; flex: none;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1.5px rgb(18 19 16 / .35);
    transition: background-color .3s, box-shadow .3s;
  }
  .story__tick :global(svg) { inline-size: 15px; block-size: 15px; opacity: 0; transform: scale(.4); transition: opacity .3s, transform .4s var(--ease-spring); }
  .story__claim li.is-done .story__tick { background: var(--lime); box-shadow: none; }
  .story__claim li.is-done .story__tick :global(svg) { opacity: 1; transform: none; }

  .story.is-live .story__tag {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    position: absolute;
    padding: .45rem .85rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: .875rem;
    white-space: nowrap;
    opacity: 0;
  }
  .story__tag--paint { top: 2%; left: var(--wave, 100%); transform: translateX(-50%); background: var(--lime); color: var(--ink); }
  .story__tag--keys { top: 4%; right: 10%; background: var(--paper); color: var(--ink); transform: translateY(16px); }
  .story__tag--keys svg { inline-size: 18px; block-size: 18px; }

  .story__bg-blue {
    background-image:
      linear-gradient(rgb(185 202 19 / .07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(185 202 19 / .07) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(70% 60% at 40% 60%, #000, transparent);
  }
  .story__bg-booth {
    background:
      linear-gradient(to bottom, rgb(255 255 240 / .10), transparent 30%),
      repeating-linear-gradient(to left, transparent 0 18%, rgb(255 255 240 / .05) 18% 19%);
  }
  .story__bg-glow { background: radial-gradient(60% 40% at 45% 85%, rgb(185 202 19 / .22), transparent 70%); }

  @media (max-width: 900px) {
    .story__in { grid-template-columns: 1fr; grid-template-areas: 'head' 'visual' 'text'; }
    .story.is-live { block-size: 420vh; }
    .story.is-live .story__stick { padding-block: calc(var(--header-h) + .5rem) 1.5rem; }
    .story.is-live .story__in { grid-template-rows: auto auto 1fr; gap: 1rem; align-content: start; }
    .story.is-live .story__title { font-size: clamp(2.2rem, 10vw, 3.4rem); }
    .story.is-live .story__intro { display: none; }
    .story.is-live .story__visual { margin-inline: calc(var(--pad) * -.25) calc(var(--pad) * -1); margin-block: 1.5rem .5rem; }
    .story.is-live .story__count { margin-block-end: .5rem; }
    .story.is-live .story__step-title { font-size: clamp(1.9rem, 8.5vw, 2.6rem); }
    .story.is-live .story__step-text { font-size: 1rem; }
    .story.is-live .story__rail { grid-template-columns: repeat(4, 1fr); gap: .4rem; margin-block-start: 1.25rem; }
    .story__rail-seg { grid-template-columns: 1fr; }
    .story__rail-seg b { display: none; }
    .story.is-live .story__claim { inset-block-start: auto; inset-block-end: 105%; left: 0; inline-size: min(250px, 70%); padding: .8rem .9rem; }
    .story__claim-title { font-size: 1.05rem; }
    .story__spot-label { font-size: .75rem; }
  }
  @media (max-height: 720px) and (min-width: 901px) {
    .story.is-live .story__intro { display: none; }
    .story.is-live .story__title { font-size: clamp(2.2rem, 4vw, 4rem); }
  }
</style>
