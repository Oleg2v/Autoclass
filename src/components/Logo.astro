---
// Auto Class logo, vectorised (potrace) from the lime wordmark published on autoclassltd.com.
// The path lives once in <LogoSymbol /> (see Base layout); the owner should supply the original vector if one exists.
interface Props { class?: string; title?: string; decorative?: boolean }
const { class: cls = '', title = 'אוטו קלאס – Auto Class', decorative = false } = Astro.props;
---
{decorative
  ? <svg class={cls} viewBox="78 17 1606 202" aria-hidden="true" focusable="false"><use href="#ac-logo" /></svg>
  : <svg class={cls} viewBox="78 17 1606 202" role="img" aria-label={title} focusable="false"><use href="#ac-logo" /></svg>}
